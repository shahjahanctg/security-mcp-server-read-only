# Optional API keys. Leave blank to run keyless providers only.
# The server skips any keyed provider whose key is unset and reports it in `skipped`.

ABUSEIPDB_API_KEY=
VT_API_KEY=
GREYNOISE_API_KEY=
SHODAN_API_KEY=
URLSCAN_API_KEY=
NVD_API_KEY=

# Optional: enriches IP lookups with IPinfo data
IPINFO_TOKEN=

# Runtime options
MOCK=0
CACHE_TTL=900
